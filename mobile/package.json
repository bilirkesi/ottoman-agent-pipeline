{
  "name": "ottoman-agent-mobile",
  "version": "0.1.0",
  "main": "mobile/App.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-screens": "^3.30.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  },
  "expo": {
    "name": "Ottoman Agent",
    "slug": "ottoman-agent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./mobile/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./mobile/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.bilirkesi.ottoman-agent"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./mobile/assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "ai.bilirkesi.ottoman_agent"
    },
    "web": {
      "favicon": "./mobile/assets/favicon.png"
    }
  }
}
